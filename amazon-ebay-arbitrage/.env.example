# Copy file này thành .env rồi điền key. KHÔNG commit file .env!
# Để trống key nào thì nguồn đó bị ẩn trong giao diện (vẫn dùng được dữ liệu giả lập).

# --- Nguồn Amazon (chọn ít nhất 1) ---
KEEPA_API_KEY=
RAINFOREST_API_KEY=
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=

# --- eBay Developer (App ID / Cert ID của keyset Production) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Chỉ bật khi eBay đã duyệt quyền Marketplace Insights API (dữ liệu Sold Listings)
EBAY_ENABLE_INSIGHTS=0

# --- AI Listing Generator (Claude) ---
ANTHROPIC_API_KEY=
LISTING_MODEL=claude-opus-5-5
